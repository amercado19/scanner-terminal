# ---- Copy to .env and fill in. NEVER commit the real .env. ----

# MongoDB Atlas (ROTATE your password first - the one you pasted is burned).
# Replace cluster0.xxxxx with your REAL cluster host from Atlas > Connect.
# Real host confirmed from your Atlas Connect > Drivers modal:
MONGODB_URI=mongodb+srv://andresmercado1919_db_user:NEW_ROTATED_PASSWORD@cluster0.rku8nto.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
DB_NAME=spy_terminal_db
COLLECTION_NAME=spy_payloads
DOC_ID=spy_live_data

# FlashAlpha (free key at https://flashalpha.com/profile). Free tier = 5 req/day.
FLASHALPHA_API_KEY=
FLASHALPHA_BASE=https://lab.flashalpha.com

# Anthropic (narrative only). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
ENABLE_LLM_NARRATIVE=true

# Price data source: alpaca (real-time IEX) or yfinance (delayed)
DATA_SOURCE=alpaca
# Free keys at https://alpaca.markets  (Paper account is fine; market-data keys work either way)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_FEED=iex

# Worker behaviour
SYMBOL=SPY
LOOP_SECONDS=120
GEX_REFRESH_SECONDS=14400
BUY_THRESHOLD=60
BB_PERIOD=20
BB_STD=2.0

# Endpoint CORS (the origin your dashboard is served from)
ALLOWED_ORIGINS=https://amercado19.github.io
