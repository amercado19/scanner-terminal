# Phase 2 tracker — environment template. Copy these into your Railway service Variables.
# NO REAL SECRETS in this file or in git — TRADIER_TOKEN is pasted only in Railway.

# --- provider selection (provider-neutral; swappable by config only) ---
TRACKER_PROVIDER=tradier
TRACKER_FALLBACK_PROVIDER=cboe

# --- Tradier real-time adapter ---
# Leave TRADIER_TOKEN EMPTY here. With it unset the worker stays NOT_CONFIGURED (dormant):
# no live quotes, no fabricated observations, nothing marked live. Paste the real token in Railway.
TRADIER_TOKEN=
TRADIER_ENV=production          # production = real-time (funded entitlement); sandbox = delayed

# --- persistence (Railway persistent volume) ---
TRACKER_STATE_DIR=/data         # mount the Railway volume here

# --- loop / health ---
TRACKER_POLL_INTERVAL_SEC=20
# PORT is injected by Railway automatically; the health server binds it (falls back to 8080).
